<Project>
    <!--
      Central package metadata and versioning for every project in the repo. MinVer derives Version from the
      nearest git tag (tags are pushed as "vX.Y.Z" — see .github/workflows/release.yml) instead of any project
      hand-maintaining its own version number; commits past a tag get an automatic prerelease suffix
      (e.g. "1.2.3-alpha.0.4+abcdef"), so a build off main between releases still produces a valid, unique,
      never-decreasing version instead of colliding with the last tagged one.
    -->

    <PropertyGroup>
        <Authors>TheKeyblader</Authors>
        <PackageProjectUrl>https://github.com/TheKeyblader/Enx.Atomic.Avalonia</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TheKeyblader/Enx.Atomic.Avalonia</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <!--
      Surfaces .editorconfig's style rules (file-scoped namespaces, unused usings, naming, ...) as real build
      warnings, so `dotnet build` is the single feedback loop for conventions — not only the IDE.
    -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Version comes from Directory.Packages.props (Central Package Management). -->
        <PackageReference Include="MinVer" PrivateAssets="All" />
    </ItemGroup>
</Project>
