<Project>
    <!--
      Central Package Management: every PackageReference in the repo is versionless, and the single version of
      each package lives here. Keeps the three shipped packages and their consumers on exactly one Avalonia
      version, and makes a dependency bump a one-line change instead of a repo-wide search-and-replace.
      MinVer itself is the one PackageReference still declared centrally (Directory.Build.props); its version is
      just another PackageVersion below.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="MinVer" Version="8.0.0" />
        <PackageVersion Include="Avalonia" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
        <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
        <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageVersion Include="Verify.XunitV3" Version="32.0.1" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>
</Project>
