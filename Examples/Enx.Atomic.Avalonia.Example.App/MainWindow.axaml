<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Enx.Atomic.Avalonia.Example.App.MainWindow"
  Classes="dark:bg-black"
  Container.Name="top-level"
  Container.Sizing="WidthAndHeight"
  Title="Example"
>
  <StackPanel Classes="flex-col p-2 lg:max-w-md">
    <TextBlock Classes="hidden" Text="Hidden by default" />
    <Button
      Classes="hover:bg-red-500 dark:hover:bg-blue-500 cursor-pointer ml-1 mr-2"
      Content="Hover me"
    />
  </StackPanel>
</Window>
