<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Opts into the build-time codegen wiring: builds the shared config project, runs it against this
         project's @(Compile) and @(AvaloniaXaml), and compiles the resulting GenStyles.g.cs/GenResources.g.cs
         into this project. The config project is reusable as-is — its theme is the one these tokens resolve
         against, so a second copy would only risk the two example apps drifting apart. -->
    <PropertyGroup>
        <EnxAtomicConfigProject>$(MSBuildThisFileDirectory)..\Enx.Atomic.Avalonia.Example.Config\Enx.Atomic.Avalonia.Example.Config.csproj</EnxAtomicConfigProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
    </ItemGroup>

    <Import Project="..\..\Sources\Enx.Atomic.Avalonia.CodeGen\build\Enx.Atomic.Avalonia.CodeGen.targets" />
</Project>
