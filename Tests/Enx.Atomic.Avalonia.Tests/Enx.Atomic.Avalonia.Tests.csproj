    <ItemGroup>
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="coverlet.msbuild" Version="10.0.1">
